<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Apenas Controllers e Actions compõem a documentação pública OpenAPI desta API. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="QuickFIXn.Core" />
    <PackageReference Include="QuickFIXn.FIX44" GeneratePathProperty="true" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\fix\initiator.cfg" Link="fix\initiator.cfg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgQuickFIXn_FIX44)\DataDictionary\FIX44.xml" Link="fix\FIX44.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrderManagement.Shared\OrderManagement.Shared.csproj" />
  </ItemGroup>

</Project>
